<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DcimCloudSync.Pages.MainPage"
             Title="Status">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,32"
            Spacing="20">
            <Label
                Style="{StaticResource PageTitleLabelStyle}"
                Text="Android DCIM Cloud Sync"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Style="{StaticResource IntroLabelStyle}"
                Text="A minimal .NET MAUI shell for learning and local Android development." />
            <Label
                Margin="0,12,0,0"
                Style="{StaticResource SectionTitleLabelStyle}"
                Text="Current status"
                SemanticProperties.HeadingLevel="Level2" />
            <Label
                Text="Backup features are not implemented. This app does not store credentials, upload files, or run background work."
                SemanticProperties.Description="Current status. Backup features are not implemented." />
            <VerticalStackLayout
                x:Name="MediaInventorySection"
                IsVisible="False"
                Spacing="12">
                <Label
                    Margin="0,12,0,0"
                    Style="{StaticResource SectionTitleLabelStyle}"
                    Text="Media inventory"
                    SemanticProperties.HeadingLevel="Level2" />
                <Label
                    Text="Reads and hashes every photo and video in the development media folder. Nothing is uploaded or stored." />
                <HorizontalStackLayout Spacing="12">
                    <Button
                        x:Name="ScanButton"
                        Text="Scan media"
                        Clicked="OnScanClicked"
                        SemanticProperties.Hint="Reads and hashes every photo and video in the development media folder" />
                    <Button
                        x:Name="CancelScanButton"
                        Text="Cancel"
                        IsEnabled="False"
                        Clicked="OnCancelScanClicked"
                        SemanticProperties.Hint="Cancels the current media scan" />
                </HorizontalStackLayout>
                <ActivityIndicator
                    x:Name="ScanActivityIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    SemanticProperties.Description="Media scan in progress" />
                <Label x:Name="ScanStatusLabel" />
            </VerticalStackLayout>
            <Label
                Margin="0,12,0,0"
                Style="{StaticResource SectionTitleLabelStyle}"
                Text="Learning surface"
                SemanticProperties.HeadingLevel="Level2" />
            <Label
                Text="Use this page to explore XAML layout, centralized theme-aware styles, and debugging on Windows or Android before product features are added." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
