<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DcimCloudSync.Pages.MainPage"
             Title="Status">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,32"
            Spacing="20">
            <Label
                Style="{StaticResource PageTitleLabelStyle}"
                Text="Android DCIM Cloud Sync"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Style="{StaticResource IntroLabelStyle}"
                Text="A minimal .NET MAUI shell for learning and local Android development." />
            <Label
                Margin="0,12,0,0"
                Style="{StaticResource SectionTitleLabelStyle}"
                Text="Current status"
                SemanticProperties.HeadingLevel="Level2" />
            <Label
                Text="Backup features are not implemented. This app does not discover media, store credentials, upload files, or run background work."
                SemanticProperties.Description="Current status. Backup features are not implemented." />
            <Label
                Margin="0,12,0,0"
                Style="{StaticResource SectionTitleLabelStyle}"
                Text="Learning surface"
                SemanticProperties.HeadingLevel="Level2" />
            <Label
                Text="Use this page to explore XAML layout, centralized theme-aware styles, and Android debugging before product features are added." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
