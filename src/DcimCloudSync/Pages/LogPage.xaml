<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DcimCloudSync.Pages.LogPage"
             Title="Log">

    <Grid
        Padding="24,32"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="12">
        <Label
            Style="{StaticResource PageTitleLabelStyle}"
            Text="Backup log"
            SemanticProperties.HeadingLevel="Level1" />
        <Label
            Grid.Row="1"
            Text="The 25 most recent scan and backup events, newest first. They stay on this device." />
        <Button
            Grid.Row="2"
            HorizontalOptions="Start"
            Text="Clear"
            Clicked="OnClearClicked"
            SemanticProperties.Hint="Removes every log entry" />
        <CollectionView
            x:Name="EntriesView"
            Grid.Row="3"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No events yet. Scan or back up to add some." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Label Padding="0,6" Text="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
